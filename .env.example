# —— LLM（新栈 5-Agent 真实调用所需）——
# OpenAI 官方或任意兼容 /v1/chat/completions 的代理
OPENAI_API_KEY=sk-your-key-here
# 用国内代理 / 第三方网关时填其 base_url；用官方留空
OPENAI_BASE_URL=
# 默认 gpt-4o-mini；可换 gpt-4o 等
OPENAI_MODEL=gpt-4o-mini

# —— 数据库（默认 sqlite，开箱即用，无需改）——
DATABASE_URL=sqlite+aiosqlite:///./study_agent.db
# PostgreSQL (生产环境取消注释):
# DATABASE_URL=postgresql+asyncpg://studyagent:studyagent@localhost:5432/studyagent

# —— 可观测（可选）——
LANGFUSE_ENABLED=false

# —— 容器部署认证与在线教学 ——
# deploy 前填写强随机 JWT；不要使用公开开发默认值。
JWT_SECRET_KEY=
# 在线 /api/chat 需要 PostgreSQL + pgvector；本地 fake 默认只供已有兼容测试。
RAG_BACKEND=pgvector
# Embedding 复用上方 OPENAI_API_KEY / OPENAI_BASE_URL；按服务实际模型与维度填写。
EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_DIM=2048
# 真实镜像教学验收需在调用进程显式设置 DOCKER_VERIFY_MODEL_TESTS=1，脚本不读取 .env。
